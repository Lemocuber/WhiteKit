{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WhiteKit",
  "version": "1.0.0",
  "identifier": "icu.lemoc.whitekit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小白箱",
        "width": 985,
        "height": 705,
        "minWidth": 985,
        "minHeight": 705
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
